# ============================================================================
# LINE API Learning Project — ตัวอย่างไฟล์ environment
# วิธีใช้: copy ไฟล์นี้เป็น .env.local แล้วเติมค่าจริงจาก LINE Developers Console
#   PowerShell:  Copy-Item .env.example .env.local
# ดูวิธีหาค่าแต่ละตัวได้ที่ docs/01-setup.md
# ============================================================================

# ---------------------------------------------------------------------------
# 1) Messaging API channel  (สำหรับบอทตอบข้อความ)
#    LINE Developers Console > Provider > channel ประเภท "Messaging API"
# ---------------------------------------------------------------------------
# แท็บ "Messaging API" > Channel access token (long-lived) > กด Issue
LINE_CHANNEL_ACCESS_TOKEN=
# แท็บ "Basic settings" > Channel secret
LINE_CHANNEL_SECRET=

# ---------------------------------------------------------------------------
# 2) LINE Login channel  (สำหรับ "เข้าสู่ระบบด้วย LINE" และ LIFF)
#    LINE Developers Console > Provider > channel ประเภท "LINE Login"
# ---------------------------------------------------------------------------
# แท็บ "Basic settings" > Channel ID  (เป็นตัวเลขล้วน)
LINE_LOGIN_CHANNEL_ID=
# แท็บ "Basic settings" > Channel secret
LINE_LOGIN_CHANNEL_SECRET=

# ---------------------------------------------------------------------------
# 3) LIFF  (เว็บแอปที่รันอยู่ในแอป LINE)
#    LINE Login channel > แท็บ "LIFF" > Add > จะได้ LIFF ID มา
#    ต้องขึ้นต้นด้วย NEXT_PUBLIC_ เพราะฝั่ง browser ต้องอ่านค่านี้
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LIFF_ID=

# ---------------------------------------------------------------------------
# 4) URL ของแอปเรา — ใช้ประกอบ redirect_uri ของ LINE Login
#    ตอน dev ที่เปิด ngrok ให้ใส่ URL ของ ngrok (https://xxxx.ngrok-free.app)
#    ตอน deploy จริงให้ใส่โดเมนจริง
#    ห้ามมี / ปิดท้าย
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 5) กุญแจสำหรับเซ็น session cookie ของแอปเรา (ไม่เกี่ยวกับ LINE)
#    สุ่มค่าใหม่ด้วย:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=dev-only-secret-change-me-please-32-chars-min
